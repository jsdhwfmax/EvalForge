EVALFORGE_ENVIRONMENT=development
EVALFORGE_DATABASE_URL=sqlite:///./evalforge.db
EVALFORGE_API_BASE_URL=http://localhost:8000
EVALFORGE_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Required on both API and dashboard when EVALFORGE_ENVIRONMENT=production.
# Use the same securely generated access key; never commit the configured value.
EVALFORGE_ACCESS_KEY=

# Only needed by an openai_compatible configuration:
OPENAI_API_KEY=
